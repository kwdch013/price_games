# 共有 PostgreSQL への接続情報（実ファイル .env は Git 管理外）
# 形式: postgresql+psycopg://<ユーザー>:<パスワード>@<ホスト>:5432/<DB名>
# 開発時はコンテナから共有 Postgres（postgres_db）へ database_default ネットワーク経由で接続する
DATABASE_URL=postgresql+psycopg://price_games:CHANGE_ME@postgres_db:5432/price_games

# Compose のホスト側ポート（必要に応じて変更）
API_HTTP_PORT=8010
FRONTEND_WEB_PORT=5173
